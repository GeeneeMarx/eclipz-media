APP_NAME="Eclipz Media & Marketing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Hosts allowed to serve the site (comma separated). Only enforced outside local
# development. Example for production: eclipzmedia.com,www.eclipzmedia.com
TRUSTED_HOSTS=
# Set to true only when the site is permanently served over HTTPS.
SECURITY_HSTS=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eclipz_media
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Mail is sent through SMTP. Keep the real password only in your own .env.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Eclipz Media & Marketing"

# First administrator for a fresh install only (at least 12 characters). Existing
# accounts are never changed. Leave blank once the account exists.
ADMIN_NAME="Richard Ese"
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Production values, for reference when the site is deployed:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-domain
#   LOG_CHANNEL=daily
#   LOG_LEVEL=warning
#   SESSION_SECURE_COOKIE=true